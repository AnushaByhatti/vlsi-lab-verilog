module tb;
    reg clk, rst;
    wire [2:0] ns_light, ew_light;

    traffic_light uut (
        .clk(clk),
        .rst(rst),
        .ns_light(ns_light),
        .ew_light(ew_light)
    );

    // Clock generation
    always #5 clk = ~clk;

    initial begin
        $dumpfile("dump.vcd");
        $dumpvars(1, tb);

        clk = 0;
        rst = 1;
        #10 rst = 0;

        // Run for enough cycles to see a full state cycle
        #300 $finish;
    end

    initial begin
        $monitor("Time=%0t | State NS=%b EW=%b", $time, ns_light, ew_light);
    end
endmodule
